include env_precomp.mk

.SUFFIXES: .pc .c .o

LDSTRING=
PRODUCT_LIBHOME=
MAKEFILE=Makefile
USERID=inkless/inkless
PROCPLSFLAGS= sqlcheck=full userid=$(USERID) dbms=v6_char
PROCPPFLAGS= code=cpp include=/usr/include include=/usr/include/cxx
INCLUDE=$(I_SYM). $(PRECOMPPUBLIC)

SAMPLES=EC_COMM 

# Rule to compile any program (specify EXE= and OBJS= on command line)

OBJS= InsertDB.o  Mapcvt_Insert.o RegistProcessCvt.o
EXE= Mapcvt_Insert.exe
#EXE= Mapcvt_Insert_DEBUG.exe

build: $(OBJS)
	$(CC) -o $(EXE) $(OBJS) -L$(LIBHOME) $(USER_PROLDLIBS) -pthread

cppbuild:
	$(PROC) $(PROCPPFLAGS) iname=$(EXE)
	cxx -x cxx -c -DA_OSF $(INCLUDE) $(EXE).c
	cxx -o $(EXE) $(OBJS) -L$(LIBHOME) $(PROLDLIBS) -pthread

all: $(SAMPLES)
cppsamples: $(CPPSAMPLES)

$(SAMPLES):
	$(MAKE) -f $(MAKEFILE) build $(OBJS)
	$(CC) -o $(EXE) $(OBJS) -L$(LIBHOME) $(PROLDLIBS) -pthread

$(CPPSAMPLES):
	$(MAKE) -f $(MAKEFILE) cppbuild OBJS=$@.o EXE=$@

sample5:
	@echo 'sample5 is a user-exit demo; use a forms makefile to build it.'

.pc.c:
	$(PROC) $(PROCFLAGS) iname=$*.pc

.pc.o:
	$(PROC) $(PROCFLAGS) iname=$*.pc
	$(CC) $(CFLAGS) -c $*.c

.c.o:
	$(CC) $(CFLAGS) -c $*.c

InsertDB.o: InsertDB.pc
	$(PROC) dbms=v6_char iname=$*.pc
	$(CC) $(CFLAGS) $(PRECOMPPUBLIC) -c $*.c

RegistProcessCvt.o: 
	$(CC) $(CFLAGS) $(PRECOMPPUBLIC) -c $*.c

cv_demo.o: cv_demo.pc cv_demo-sql
	$(PROC) $(PROCPLSFLAGS) iname=$*.pc
	$(CC) $(CFLAGS) $(PRECOMPPUBLIC) -c $*.c

sample11.o: sample11.pc sample11-sql
	$(PROC) $(PROCPLSFLAGS) iname=$*.pc dbms=v6
	$(CC) $(CFLAGS) $(PRECOMPPUBLIC) -c $*.c

calldemo-sql:
	sqlplus scott/tiger @../sql/calldemo </dev/null

sample11-sql:
	sqlplus scott/tiger @../sql/sample11 </dev/null

cv_demo-sql:
	sqlplus scott/tiger @../sql/cv_demo </dev/null
